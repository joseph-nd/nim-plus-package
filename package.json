{
	"name": "nim-plus-package",
	"version": "0.12.2",
	"description": "Foundry VTT module that adds Nim+ content to the Nimble system.",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "node ./build/smoke.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"build": "node ./build/buildCompendia.mjs",
		"build:compendia": "node ./build/buildCompendia.mjs",
		"release": "node ./build/release.mjs",
		"dev:link": "node ./build/link.mjs",
		"dev:unlink": "node ./build/link.mjs --unlink",
		"clean": "rm -rf packs/nim-plus-* dist"
	},
	"engines": {
		"node": ">=22.1.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.11.0",
	"devDependencies": {
		"classic-level": "^1.4.1",
		"glob": "^11.0.3",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"classic-level"
		]
	}
}
